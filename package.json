{
  "name": "mercadinho-joao",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de vendas e estoque para Mercadinho do João",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "node prisma/seed.js",
    "seed:products": "node prisma/seedProducts.js",
    "seed:perfis": "node prisma/seedPerfis.js",
    "simulate:sales": "node prisma/simulateSales.js",
    "simulate:history": "node prisma/simulateHistory.js",
    "reset-password": "node prisma/resetPassword.js",
    "test": "node --test test/integration.test.js test/retryStaleRead.test.js test/historyGenerator.test.js test/exportService.test.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.20.0"
  },
  "engines": {
    "node": ">=18"
  }
}
