# Scripts de shell rodam dentro do container Linux: com quebra de linha do
# Windows (CRLF) o "#!/bin/sh" vira "#!/bin/sh\r" e o container não sobe
# ("wait-for-db.sh: not found"). Força LF mesmo com core.autocrlf=true.
*.sh text eol=lf

# Arquivos do Windows: CRLF também no ZIP baixado pelo GitHub.
*.bat text eol=crlf
*.ps1 text eol=crlf
